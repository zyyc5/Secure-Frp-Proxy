# Secure RDP Manager static configuration
PORT=9108
TCP_PROXY_PORT=13389
APP_USERNAME=admin
APP_PASSWORD=replace-with-a-strong-password
TRUST_PROXY=false
HTTPS_TERMINATOR_ENABLED=false
HTTPS_TERMINATOR_PORT=9443
HTTPS_TERMINATOR_HOST=127.0.0.1

# Secure FRP Proxy Server control plane
CONTROL_PLANE_URL=http://127.0.0.1:9200
CONTROL_PLANE_API_KEY=replace-with-the-control-plane-api-key
# Leave empty to generate and persist a stable client ID during the first sync.
CONTROL_PLANE_CLIENT_ID=
CONTROL_PLANE_CERT_DOMAIN=proxy2.example.com
CONTROL_PLANE_CERTIFICATE_VERSION=

# Optional: write directly to the active FRPC configuration.
# CONTROL_PLANE_FRPC_PATH=config/frpc.toml
# CONTROL_PLANE_TCP_LOCAL_PORT=13389
# CONTROL_PLANE_HTTPS_LOCAL_PORT=9443
